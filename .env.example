# Copy to .env and fill in.

# --- Database (defaults to SQLite at ./data/agent.db) ---
# DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent

# --- LLM provider ---
# LLM_PROVIDER=gemini   (or "null" for offline heuristic analysis)
LLM_PROVIDER=null
GEMINI_API_KEY=
# Multiple keys (comma-separated) form a rotation ring: each key gets its own
# daily budget and a quota-exhausted key is skipped for the rest of the day.
# GEMINI_API_KEYS=key1,key2,key3
# Use a "-latest" model alias: the 2.x names are deprecated for new keys.
GEMINI_MODEL=gemini-flash-latest

# Resilience: successful Gemini responses are cached on disk (re-runs cost 0
# extra calls), each key's daily budget caps spending (default 20 = free tier),
# and any failure/quota-exhaustion rotates to the next key then degrades
# gracefully to the offline heuristics.
# Set LLM_FALLBACK=false for fail-fast mode and LLM_DAILY_BUDGET=0 for unlimited.
# LLM_CACHE_PATH=data/llm_cache.json
# LLM_BUDGET_PATH=data/llm_budget.json
LLM_DAILY_BUDGET=20
LLM_FALLBACK=true

# --- Email (disabled by default: set ENABLE_EMAIL=true to allow Gmail) ---
ENABLE_EMAIL=false
# Modes: dry_run (validate only, no Gmail) | draft (create Gmail Draft) | live (send)
EMAIL_MODE=draft
EMAIL_PROVIDER=gmail            # log | smtp | gmail
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Outbound communication policy (configurable, no code changes)
# DAILY_MAX_APPLICATIONS=5     APPLY emails per day
# DAILY_MAX_INQUIRIES=5        ASK_EMPLOYER / info requests per day
# DAILY_MAX_OUTBOUND=10        total outbound emails per day
# EMPLOYER_COOLDOWN_DAYS=7     cooldown between any contact with the same company
# MIN_APPLICATION_SCORE=80     min opportunity score to auto-apply
# MIN_APPLICATION_CONFIDENCE=0.80   min agent confidence to auto-apply

# Application guardrails
# APPLY_DAILY_LIMIT=10
# GLOBAL_PAUSE=false